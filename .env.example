# TestRail MCP Server (on-prem): copy this file to .env and edit it.
# `docker compose` reads .env from this folder to fill the ${...} values in
# docker-compose.yml.

# Required. The TestRail Server instance this MCP server talks to, as the
# container reaches it: http(s)://host[:port][/path], no query string.
# Keep the path for installs mounted under one, e.g.
# https://testrail.corp.example/testrail
TESTRAIL_ON_PREM_INSTANCE=https://testrail.corp.example

# Host port the server is published on. Inside the container it always
# listens on 8000.
TESTRAIL_MCP_PORT=8000

# Optional. Log format: `human` (default) or `json` for a log shipper.
# MCP_LOG_FORMAT=json

# Optional. Ceiling in seconds for one tool call, default 120.
# SEMBI_TOOL_TIMEOUT_SECONDS=120

# Optional. Where the check_testrail_version tool asks for the latest TestRail Server
# release. Empty: TestRail's own update-check endpoint
# (https://secure.testrail.com/customers/testrail/version/get). `off`: no
# outbound request at all, for air-gapped sites; the version known at the
# time of this image release answers instead.
# TESTRAIL_VERSION_CHECK_URL=off

# Optional. Where the check_mcp_version tool asks for the latest release of
# this MCP server. Empty: the VERSION file of this bundle's repository
# (https://raw.githubusercontent.com/sembi-oss/testrail-mcp-docker/main/VERSION); a
# replacement must answer a bare x.y.z, like it. `off`: no outbound request at
# all, for air-gapped sites; the tool then reports the running version only.
# TESTRAIL_MCP_VERSION_CHECK_URL=off

# Optional. Run a different image tag than the release line this bundle
# shipped with: an exact x.y.z you have loaded, to freeze a deployment or to
# go back to an earlier release.
# TESTRAIL_MCP_VERSION=0.2.1

# Optional. Another image name, if you re-tag the loaded image for your own
# registry.
# TESTRAIL_MCP_IMAGE=registry.corp.example/testrail/mcp
